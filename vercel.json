{
  "version": 2,
  "installCommand": "npm ci && npm --prefix admin-ui ci",
  "buildCommand": "npx prisma generate && npm run build && npm run build:client",
  "outputDirectory": "admin-ui/dist",
  "redirects": [{ "source": "/", "destination": "/admin", "permanent": false }],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/:companySlug/:secret/iclock/:path*", "destination": "/api" },
    { "source": "/health", "destination": "/api" },
    { "source": "/admin/assets/:path*", "destination": "/assets/:path*" },
    { "source": "/admin/:path*", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.ts": {
      "includeFiles": "node_modules/.prisma/client/**",
      "maxDuration": 60
    }
  }
}
